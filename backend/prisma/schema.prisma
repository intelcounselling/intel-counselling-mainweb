// Prisma Schema — Intel Student Success System™
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  // PSYCHIATRIST is deprecated/unused: the SUPER_ADMIN now fulfils the
  // counsellor role. The enum value is kept only so `prisma db push` never
  // needs --accept-data-loss on the production database — no users carry
  // this role and no code creates one.
  PSYCHIATRIST
  PARENT
  STUDENT
}

enum ApptStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AlertStatus {
  UNREAD
  READ
  ACTIONED
}

enum ConcernStatus {
  RECEIVED
  REVIEWED
}

// Which ISSS package a school or family has purchased
enum Package {
  SCHOOL_INSIGHT           // Package 1 — School management analytics
  PARENT_INSIGHT           // Package 2 — Parent/child comparison
  PREMIUM_TRANSFORMATION   // Package 3 — Full assessment + counselling + tracking
}

// ─────────────────────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────────────────────

model School {
  id           String   @id @default(uuid())
  name         String
  address      String?
  contactEmail String
  contactPhone String?
  logoUrl      String?
  accessCode   String   @unique
  isActive     Boolean  @default(true)
  package      Package  @default(SCHOOL_INSIGHT)
  createdAt    DateTime @default(now())

  users         User[]
  families      Family[]
  classes       Class[]
}

// Class/Section within a school (Package 1)
model Class {
  id       String  @id @default(uuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  name     String  // e.g. "Grade 6A"
  grade    String  // e.g. "6"
  section  String? // e.g. "A"

  students User[] @relation("ClassStudents")
}

model Family {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  package   Package  @default(PARENT_INSIGHT)
  createdAt DateTime @default(now())

  students User[] @relation("FamilyStudents")
  parents  User[] @relation("FamilyParents")
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String
  role              Role
  firstName         String
  lastName          String
  phone             String?
  avatarUrl         String?
  schoolId          String?
  school            School?  @relation(fields: [schoolId], references: [id])
  classId           String?
  class             Class?   @relation("ClassStudents", fields: [classId], references: [id])
  familyAsStudent   Family?  @relation("FamilyStudents", fields: [familyStudentId], references: [id])
  familyStudentId   String?
  familyAsParent    Family?  @relation("FamilyParents", fields: [familyParentId], references: [id])
  familyParentId    String?
  grade             String?
  dateOfBirth       DateTime?
  isActive          Boolean  @default(true)
  mustResetPassword Boolean  @default(true)
  otpCode           String?
  otpExpiresAt      DateTime?
  createdAt         DateTime @default(now())

  // Psychiatrist ↔ School many-to-many (removed — the SUPER_ADMIN now
  // fulfils the counsellor role; appointments reference them directly)

  testResults              TestResult[]
  appointments             Appointment[] @relation("PatientAppointments")
  managedAppointments      Appointment[] @relation("PsychiatristAppointments")
  alerts                   Alert[]
  concerns                 Concern[]
  refreshTokens            RefreshToken[]
  counsellingNotesWritten  CounsellingNote[] @relation("CounsellorNotes")
}

model Test {
  id               String   @id @default(uuid())
  name             String
  description      String
  category         String   // e.g. "LearningPattern", "StudyBehaviour", "EmotionalWellness"
  questions        Json
  thresholds       Json
  estimatedMinutes Int      @default(5)
  isActive         Boolean  @default(true)
  isSensitive      Boolean  @default(false)  // Sensitive: emotional wellness — restrict individual data
  createdAt        DateTime @default(now())

  results TestResult[]
}

model TestResult {
  id                  String   @id @default(uuid())
  studentId           String
  student             User     @relation(fields: [studentId], references: [id])
  testId              String
  test                Test     @relation(fields: [testId], references: [id])
  score               Int
  maxScore            Int
  severity            String
  // For Learning Pattern: store sub-scores per dimension
  subScores           Json?    // e.g. { "Visual": 18, "Auditory": 12, "Kinesthetic": 10 }
  answers             Json
  isLow               Boolean  @default(false)
  sharedWithTherapist Boolean  @default(false)
  // For Package 2: flag if this result is from parent's perspective
  isParentPerspective Boolean  @default(false)
  parentId            String?  // which parent submitted this
  takenAt             DateTime @default(now())

  appointments    Appointment[]
  CounsellingNote CounsellingNote[]
}

model Appointment {
  id             String     @id @default(uuid())
  patientId      String
  patient        User       @relation("PatientAppointments", fields: [patientId], references: [id])
  psychiatristId String
  psychiatrist   User       @relation("PsychiatristAppointments", fields: [psychiatristId], references: [id])
  slot           DateTime
  status         ApptStatus @default(PENDING)
  notes          String?
  meetingLink    String?
  createdAt      DateTime   @default(now())

  results         TestResult[]
  counsellingNotes CounsellingNote[]
}

// Counsellor session notes (Package 3)
model CounsellingNote {
  id             String      @id @default(uuid())
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  resultId       String?
  result         TestResult?  @relation(fields: [resultId], references: [id])
  counsellorId   String
  counsellor     User         @relation("CounsellorNotes", fields: [counsellorId], references: [id])
  patientId      String       // denormalized for easy querying
  sessionDate    DateTime
  summary        String
  goals          String?
  nextSteps      String?
  isConfidential Boolean      @default(true)
  createdAt      DateTime     @default(now())
}

model Alert {
  id        String      @id @default(uuid())
  studentId String
  student   User        @relation(fields: [studentId], references: [id])
  resultId  String
  severity  String
  message   String
  status    AlertStatus @default(UNREAD)
  firedAt   DateTime    @default(now())
}

model Concern {
  id        String        @id @default(uuid())
  studentId String
  student   User          @relation(fields: [studentId], references: [id])
  message   String
  status    ConcernStatus @default(RECEIVED)
  createdAt DateTime      @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// MAIN-SITE TABLES (career guidance test / payments)
// These tables are created and managed by backend/src/db.js via raw SQL
// (the main site stores them in the same Postgres database). They are
// declared here ONLY so `prisma db push` recognises them as owned and
// never drops them as "drift". Keep the columns in sync with the
// CREATE TABLE statements in db.js — do not query them via Prisma.
// ─────────────────────────────────────────────────────────────

model CareerUser {
  id            String    @id @db.Text
  name          String    @db.Text
  email         String    @unique @db.Text
  password      String    @db.Text
  phone         String?   @db.Text
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  otpCode       String?   @map("otp_code") @db.Text
  otpExpiresAt  DateTime? @map("otp_expires_at") @db.Timestamptz(6)
  otpPurpose    String?   @map("otp_purpose") @db.Text
  otpLastSentAt DateTime? @map("otp_last_sent_at") @db.Timestamptz(6)
  otpAttempts   Int?      @default(0) @map("otp_attempts")
  tokenVersion  Int?      @default(0) @map("token_version")
  emailVerified Int?      @map("email_verified")

  @@map("users")
}

model CareerAssessmentResult {
  id               String    @id @db.Text
  encryptedAnswers String    @map("encrypted_answers") @db.Text
  iv               String    @db.Text
  userId           String?   @map("user_id") @db.Text
  testId           String?   @map("test_id") @db.Text
  registration     String?   @db.Text
  registrationIv   String?   @map("registration_iv") @db.Text
  orderId          String?   @map("order_id") @db.Text
  emailedAt        DateTime? @map("emailed_at") @db.Timestamptz(6)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "idx_results_user")
  @@map("assessment_results")
}

model CareerOrder {
  orderId   String    @id @map("order_id") @db.Text
  serviceId String    @map("service_id") @db.Text
  amount    Float
  status    String    @default("CREATED") @db.Text
  resultId  String?   @map("result_id") @db.Text
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_orders_created")
  @@map("orders")
}
